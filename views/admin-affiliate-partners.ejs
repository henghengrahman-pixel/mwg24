<!DOCTYPE html>
<html lang="id">
<%- include("partials/head") %>
<body class="admin-page">
<div class="admin-layout">
<%- include("partials/admin-sidebar") %>
<main class="admin-main">
  <header class="admin-head"><div><p class="admin-kicker">MWG24 / ADMIN</p><h1>Kelola Partner Affiliate</h1><p class="admin-subtitle">Kelola data website secara langsung dari database.</p></div><a class="admin-view-site" href="/rekomendasi" target="_blank" rel="noopener noreferrer">Lihat katalog ↗</a></header>
<section class="admin-panel"><div class="admin-panel-title"><h2><%= item?'Edit Partner':'Tambah Partner' %></h2><a href="/admin/affiliate/partners">Form baru</a></div><form class="admin-form admin-editor" method="post" action="/admin/affiliate/partners/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id||'' %>"><div class="admin-fields"><label>Nama partner *<input required name="name" value="<%= item?.name||'' %>"></label><label>Slug<input name="slug" value="<%= item?.slug||'' %>"></label><label>Jenis partner<input name="type" value="<%= item?.type||'' %>"></label><label>Website HTTPS<input type="url" name="website" value="<%= item?.website||'' %>"></label><label>Affiliate base URL HTTPS<input type="url" name="affiliate_base_url" value="<%= item?.affiliate_base_url||'' %>"></label><label>Logo HTTPS<input type="url" name="logo" data-preview="partner-preview" value="<%= item?.logo||'' %>"><img id="partner-preview" class="admin-image-preview" alt="Pratinjau logo" hidden></label></div><div class="admin-checks"><label><input type="checkbox" name="is_active" value="1" <%= (item?.is_active??1)?'checked':'' %>> Aktif</label></div><div class="admin-actions"><button>Simpan Partner</button><a href="/admin/affiliate/partners">Batal</a></div></form></section>
<section class="admin-panel"><div class="admin-panel-title"><h2>Daftar Partner (<%= items.length %>)</h2><input class="admin-search" type="search" placeholder="Cari partner..." oninput="document.querySelectorAll('#partner-rows tr').forEach(x=>x.hidden=!x.textContent.toLowerCase().includes(this.value.toLowerCase()))"></div><div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Partner</th><th>Jenis</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="partner-rows"><% items.forEach(x=>{ %><tr><td><strong><%= x.name %></strong></td><td><%= x.type %></td><td><span class="admin-status <%= x.is_active?'on':'off' %>"><%= x.is_active?'Aktif':'Nonaktif' %></span></td><td class="admin-row-actions"><a href="/admin/affiliate/partners/edit/<%= x.id %>">Edit</a><form method="post" action="/admin/affiliate/partners/archive/<%= x.id %>" onsubmit="return confirm('Nonaktifkan partner?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-danger" <%= x.is_active?'':'disabled' %>>Arsip</button></form></td></tr><% }) %></tbody></table></div></section>
</main></div>
<script>document.querySelectorAll('input[type=url][data-preview]').forEach(el=>{const img=document.getElementById(el.dataset.preview);if(!img)return;const update=()=>{const valid=/^https:\/\//i.test(el.value);img.hidden=!valid;if(valid)img.src=el.value;};el.addEventListener('input',update);img.addEventListener('error',()=>img.hidden=true);update();});</script>
</body></html>