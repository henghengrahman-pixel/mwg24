<!DOCTYPE html><html lang="id"><%- include("partials/head") %><body class="admin-page"><div class="admin-layout"><%- include("partials/admin-sidebar") %><main class="admin-main"><h1>Kelola Partner</h1><form action="/admin/affiliate/partners/save" method="post" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id||'' %>"><input name="name" required placeholder="Nama Partner" value="<%= item?.name||'' %>"><input name="slug" placeholder="Slug" value="<%= item?.slug||'' %>"><input name="type" placeholder="Partner type" value="<%= item?.type||'' %>"><input type="url" name="website" placeholder="Website HTTPS" value="<%= item?.website||'' %>"><input type="url" name="affiliate_base_url" placeholder="Affiliate base URL" value="<%= item?.affiliate_base_url||'' %>"><input type="url" name="logo" placeholder="Logo HTTPS URL" value="<%= item?.logo||'' %>"><label><input type="checkbox" name="is_active" value="1" <%= (item?.is_active??1)?'checked':'' %>> Aktif</label><button>Simpan Partner</button><a href="/admin/affiliate/partners">Batal</a></form><table class="admin-table"><tr><th>Nama</th><th>Aksi</th></tr><% items.forEach(x=>{ %><tr><td><%= x.name %></td><td><a href="/admin/affiliate/partners/edit/<%= x.id %>">Edit</a> <form method="post" action="/admin/affiliate/partners/archive/<%= x.id %>" style="display:inline" onsubmit="return confirm('Nonaktifkan partner?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Arsip</button></form></td></tr><% }) %></table></main></div></body></html>