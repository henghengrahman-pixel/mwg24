<!DOCTYPE html>
<html lang="id">
<%- include("partials/head") %>
<body>
  <%- include("partials/header") %>
  <main style="max-width:1100px;margin:40px auto;padding:0 16px;">
    <h1>Rekomendasi Belanja</h1>
    <p>Pilihan produk dan perlengkapan perjalanan dari mitra belanja.</p>
    <p class="affiliate-disclosure">Beberapa tautan di bawah ini adalah tautan affiliate. Kami mungkin menerima komisi jika Anda melakukan pembelian melalui tautan tersebut, tanpa biaya tambahan untuk Anda.</p>
    <div class="affiliate-product-grid">
      <% if (!products.length) { %><p>Belum ada produk aktif. Silakan kembali lagi nanti.</p><% } %>
      <% products.forEach(p => { %>
        <div class="affiliate-product-card">
          <div class="affiliate-product-media"><% if (p.image && /^https:\/\//.test(p.image)) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentElement.classList.add('image-unavailable')"><% } else { %><span>Foto produk belum tersedia</span><% } %></div>
          <div class="affiliate-product-content"><small><%= p.partner_name || "Mitra belanja" %></small><h3><%= p.name %></h3>
          <% if (p.price) { %><p class="affiliate-price"><%= p.price %></p><% } %>
          <p><%= p.description || "" %></p>
          <a href="/go/<%= p.id %>?p=catalog" target="_blank" rel="sponsored nofollow noopener noreferrer" class="affiliate-product-button">Lihat Produk →</a></div>
        </div>
      <% }) %>
    </div>
  </main>
  <%- include("partials/footer") %>
</body>
</html>
