<aside class="admin-sidebar" aria-label="Navigasi admin">
  <a class="admin-brand" href="/admin">MWG24 <small>Content Management</small></a>
  <% const current = path || ''; %>
  <div class="admin-nav-heading">UTAMA</div>
  <% [['/admin','Dashboard'],['/admin/wisata','Tempat Wisata'],['/admin/villa','Villa & Hotel'],['/admin/kuliner','Kuliner'],['/admin/berita','Berita'],['/admin/gallery','Galeri'],['/admin/comments','Komentar'],['/admin/settings','Pengaturan']].forEach(([url,label])=>{ %>
    <a href="<%= url %>" class="admin-nav-link <%= (url==='/admin' ? current==='/admin' : current.startsWith(url))?'active':'' %>"><%= label %></a>
  <% }) %>
  <div class="admin-nav-heading">REKOMENDASI BELANJA</div>
  <% [['/admin/affiliate','Ringkasan Affiliate'],['/admin/affiliate/products','Produk'],['/admin/affiliate/partners','Partner'],['/admin/affiliate/categories','Kategori'],['/admin/affiliate/placements','Penempatan'],['/admin/affiliate/campaigns','Campaign'],['/admin/affiliate/clicks','Analitik Klik'],['/admin/affiliate/conversions','Konversi']].forEach(([url,label])=>{ %>
    <a href="<%= url %>" class="admin-nav-link <%= (url==='/admin/affiliate' ? current==url : current.startsWith(url))?'active':'' %>"><%= label %></a>
  <% }) %>
  <div class="admin-nav-heading">AKUN</div>
  <a href="/rekomendasi" class="admin-nav-link" target="_blank" rel="noopener noreferrer">Lihat Katalog ↗</a>
  <a href="/admin/logout" class="admin-nav-link">Keluar</a>
</aside>