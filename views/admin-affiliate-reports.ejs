<!DOCTYPE html>
<html lang="id">
<%- include("partials/head") %>
<body class="admin-page">
<div class="admin-layout">
<%- include("partials/admin-sidebar") %>
<main class="admin-main">
  <header class="admin-head"><div><p class="admin-kicker">MWG24 / ADMIN</p><h1><%= title %></h1><p class="admin-subtitle">Kelola data website secara langsung dari database.</p></div><a class="admin-view-site" href="/rekomendasi" target="_blank" rel="noopener noreferrer">Lihat katalog ↗</a></header>
<section class="admin-panel"><h2>Riwayat data</h2><div class="admin-table-scroll"><table class="admin-table"><% if(items.length){ %><thead><tr><% Object.keys(items[0]).forEach(k=>{ %><th><%= k %></th><% }) %></tr></thead><tbody><% items.forEach(row=>{ %><tr><% Object.values(row).forEach(v=>{ %><td><%= v??'—' %></td><% }) %></tr><% }) %></tbody><% }else{ %><tbody><tr><td>Belum ada data terverifikasi.</td></tr></tbody><% } %></table></div></section>
</main></div>
<script>document.querySelectorAll('input[type=url][data-preview]').forEach(el=>{const img=document.getElementById(el.dataset.preview);if(!img)return;const update=()=>{const valid=/^https:\/\//i.test(el.value);img.hidden=!valid;if(valid)img.src=el.value;};el.addEventListener('input',update);img.addEventListener('error',()=>img.hidden=true);update();});</script>
</body></html>