<!DOCTYPE html><html lang="id"><%- include("partials/head") %><body class="admin-page"><div class="admin-layout"><%- include("partials/admin-sidebar") %><main class="admin-main"><h1><%= title %></h1><table class="admin-table"><% if(items.length){ %><tr><% Object.keys(items[0]).forEach(k=>{ %><th><%= k %></th><% }) %></tr><% items.forEach(row=>{ %><tr><% Object.values(row).forEach(v=>{ %><td><%= v??'' %></td><% }) %></tr><% }) %><% }else{ %><tr><td>Belum ada data terverifikasi</td></tr><% } %></table></main></div></body></html>