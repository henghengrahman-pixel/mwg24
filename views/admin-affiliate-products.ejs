<!DOCTYPE html>
<html lang="id">
<%- include("partials/head") %>
<body class="admin-page">
  <div class="admin-layout">
    <%- include("partials/admin-sidebar") %>
    <main class="admin-main">
      <h1>Affiliate Products</h1>
      <form action="/admin/affiliate/products/save" method="post" class="admin-form">
        <input type="text" name="name" placeholder="Nama Produk" required>
        <input type="url" name="affiliate_url" placeholder="https://affiliate-link.com" required>
        <input type="url" name="image" placeholder="https://gambar.jpg">
        <textarea name="description" placeholder="Deskripsi"></textarea>
        <button type="submit">Simpan Produk</button>
      </form>
      <hr>
      <table>
        <% items.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td><a href="/go/<%= item.id %>" target="_blank">Test Link</a></td>
          </tr>
        <% }) %>
      </table>
    </main>
  </div>
</body>
</html>
