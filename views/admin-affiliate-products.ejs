<!DOCTYPE html><html lang="id"><%- include("partials/head") %><body class="admin-page"><div class="admin-layout"><%- include("partials/admin-sidebar") %><main class="admin-main"><h1>Kelola Produk Affiliate</h1><form action="/admin/affiliate/products/save" method="post" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id || '' %>"><input required name="name" placeholder="Nama" value="<%= item?.name || '' %>"><input name="slug" placeholder="Slug" value="<%= item?.slug || '' %>"><textarea name="description" placeholder="Deskripsi"><%= item?.description || '' %></textarea><input type="url" name="affiliate_url" required placeholder="HTTPS Affiliate URL" value="<%= item?.affiliate_url || '' %>"><input type="url" name="image" placeholder="HTTPS image URL" value="<%= item?.image || '' %>"><textarea name="images" placeholder="URL gambar lain, satu per baris"><%= (()=>{try{return JSON.parse(item?.images||'[]').join('\n')}catch{return ''}})() %></textarea><input name="price" placeholder="Harga" value="<%= item?.price || '' %>"><select name="partner_id"><option value="">Pilih Partner</option><% partners.forEach(x=>{ %><option value="<%= x.id %>" <%= item?.partner_id===x.id?'selected':'' %>><%= x.name %></option><% }) %></select><select name="category_id"><option value="">Pilih Kategori</option><% categories.forEach(x=>{ %><option value="<%= x.id %>" <%= item?.category_id===x.id?'selected':'' %>><%= x.name %></option><% }) %></select><input name="meta_title" placeholder="Meta title" value="<%= item?.meta_title || '' %>"><textarea name="meta_description" placeholder="Meta description"><%= item?.meta_description || '' %></textarea><label><input type="checkbox" name="is_active" value="1" <%= (item?.is_active ?? 1)?'checked':'' %>> Aktif</label><label><input type="checkbox" name="is_featured" value="1" <%= item?.is_featured?'checked':'' %>> Featured</label><button type="submit">Simpan Produk</button><a href="/admin/affiliate/products">Batal</a></form><table class="admin-table"><tr><th>Produk</th><th>Status</th><th>Aksi</th></tr><% items.forEach(x=>{ %><tr><td><%= x.name %></td><td><%= x.is_active?'Aktif':'Nonaktif' %></td><td><a href="/admin/affiliate/products/edit/<%= x.id %>">Edit</a> <form action="/admin/affiliate/products/archive/<%= x.id %>" method="post" style="display:inline" onsubmit="return confirm('Nonaktifkan produk?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Arsip</button></form></td></tr><% }) %></table></main></div></body></html>