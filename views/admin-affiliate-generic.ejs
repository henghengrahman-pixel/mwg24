<!DOCTYPE html><html lang="id"><%- include("partials/head") %><body class="admin-page"><div class="admin-layout"><%- include("partials/admin-sidebar") %><main class="admin-main"><h1><%= config.title %></h1><form method="post" action="/admin/affiliate/<%= moduleKey %>/save" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id||'' %>"><% config.fields.forEach(field=>{ %><label><%= field %><% if(field==='is_active'){ %><input type="checkbox" name="<%= field %>" value="1" <%= (item?.[field]??1)?'checked':'' %>><% } else if(field==='product_id'||field==='partner_id'){const options=field==='product_id'?products:partners;%><select name="<%= field %>"><option value="">- Pilih -</option><% options.forEach(x=>{ %><option value="<%= x.id %>" <%= item?.[field]===x.id?'selected':'' %>><%= x.name %></option><% }) %></select><% }else{ %><input name="<%= field %>" value="<%= item?.[field]??'' %>" <%= ['affiliate_url','banner_image'].includes(field)?'type=url':'' %>><% } %></label><% }) %><button>Simpan</button><a href="/admin/affiliate/<%= moduleKey %>">Batal</a></form><table class="admin-table"><tr><th>ID</th><th>Data</th><th>Aksi</th></tr><% items.forEach(x=>{ %><tr><td><%= x.id %></td><td><%= x.name||x.placement_key %></td><td><a href="/admin/affiliate/<%= moduleKey %>/edit/<%= x.id %>">Edit</a><form method="post" action="/admin/affiliate/<%= moduleKey %>/delete/<%= x.id %>" style="display:inline" onsubmit="return confirm('Hapus/arsip data?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Hapus/Arsip</button></form></td></tr><% }) %></table></main></div></body></html>