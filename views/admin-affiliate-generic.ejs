<!DOCTYPE html>
<html lang="id">
<%- include("partials/head") %>
<body class="admin-page">
<div class="admin-layout">
<%- include("partials/admin-sidebar") %>
<main class="admin-main">
  <header class="admin-head"><div><p class="admin-kicker">MWG24 / ADMIN</p><h1><%= config.title %></h1><p class="admin-subtitle">Kelola data website secara langsung dari database.</p></div><a class="admin-view-site" href="/rekomendasi" target="_blank" rel="noopener noreferrer">Lihat katalog ↗</a></header>
<section class="admin-panel"><div class="admin-panel-title"><h2><%= item?'Edit':'Tambah' %> <%= config.title %></h2><a href="/admin/affiliate/<%= moduleKey %>">Form baru</a></div><form method="post" action="/admin/affiliate/<%= moduleKey %>/save" class="admin-form admin-editor"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id||'' %>"><div class="admin-fields"><% config.fields.forEach(field=>{ %><label><%= ({name:'Nama',slug:'Slug',product_id:'Produk',partner_id:'Partner',placement_key:'Lokasi penempatan',priority:'Prioritas',is_active:'Aktif',banner_image:'URL banner',affiliate_url:'URL affiliate',start_date:'Tanggal mulai',end_date:'Tanggal selesai'})[field]||field %><% if(field==='is_active'){ %><input type="checkbox" name="<%= field %>" value="1" <%= (item?.[field]??1)?'checked':'' %>><% }else if(['product_id','partner_id'].includes(field)){const options=field==='product_id'?products:partners;%><select name="<%= field %>"><option value="">Pilih</option><% options.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(item?.[field])===x.id?'selected':'' %>><%= x.name %></option><% }) %></select><% }else{ %><input name="<%= field %>" type="<%= ['affiliate_url','banner_image'].includes(field)?'url':['start_date','end_date'].includes(field)?'date':['priority'].includes(field)?'number':'text' %>" value="<%= item?.[field]??'' %>"><% } %></label><% }) %></div><div class="admin-actions"><button>Simpan</button><a href="/admin/affiliate/<%= moduleKey %>">Batal</a></div></form></section><section class="admin-panel"><h2>Data Tersimpan (<%= items.length %>)</h2><div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>ID</th><th>Nama / Penempatan</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% items.forEach(x=>{ %><tr><td><%= x.id %></td><td><%= x.name||x.placement_key||x.slug||'—' %></td><td><%= typeof x.is_active!=='undefined'?(x.is_active?'Aktif':'Nonaktif'):'—' %></td><td class="admin-row-actions"><a href="/admin/affiliate/<%= moduleKey %>/edit/<%= x.id %>">Edit</a><form method="post" action="/admin/affiliate/<%= moduleKey %>/delete/<%= x.id %>" onsubmit="return confirm('Hapus atau arsip item ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-danger">Hapus/Arsip</button></form></td></tr><% }) %></tbody></table></div></section>
</main></div>
<script>document.querySelectorAll('input[type=url][data-preview]').forEach(el=>{const img=document.getElementById(el.dataset.preview);if(!img)return;const update=()=>{const valid=/^https:\/\//i.test(el.value);img.hidden=!valid;if(valid)img.src=el.value;};el.addEventListener('input',update);img.addEventListener('error',()=>img.hidden=true);update();});</script>
</body></html>